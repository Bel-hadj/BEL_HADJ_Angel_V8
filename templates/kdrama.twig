{% extends "base.twig" %}

{% block main %}
{% set k = t.kdrama %}
{% include "_page_hero.twig" with {eyebrow: k.eyebrow, title: k.title, lead: k.lead} only %}

<div class="container catalog">
	<aside class="catalog__side">
		{% include "_toc.twig" with {title: k.plan, items: articles, prefix: 'kdrama'} only %}
	</aside>

	<div class="entries">
		{% for article in articles %}
		<article id="kdrama-{{ article.id }}" class="entry" aria-labelledby="kdrama-{{ article.id }}-title">
			<div class="entry__media">
				<img src="{{ article.poster }}" alt="{{ fmt(k.poster_alt, article.titre) }}" width="400" height="600" loading="lazy">
			</div>

			<div class="entry__body">
				<header class="entry__head">
					<h2 id="kdrama-{{ article.id }}-title">{{ article.titre }}</h2>
					{% if article.sous_titre %}<p class="entry__subtitle">{{ article.sous_titre }}</p>{% endif %}
					<ul class="chips">
						<li class="chip chip--accent">{{ article.sortie }}</li>
						<li class="chip">{{ article.pays }}</li>
						<li class="chip">{{ article.statue }}</li>
					</ul>
				</header>

				<h3>{{ k.synopsis }}</h3>
				{% for paragraph in article.resume %}
				<p>{{ paragraph }}</p>
				{% endfor %}

				<h3>{{ k.details }}</h3>
				<dl class="facts">
					{% for field, label in k.labels %}
					{% if attribute(article, field) is defined and attribute(article, field) %}
					<div><dt>{{ label }}</dt><dd>{{ attribute(article, field) }}</dd></div>
					{% endif %}
					{% endfor %}
				</dl>

				{% if article.casting %}
				<h3>{{ k.cast }}</h3>
				<ul class="cast">
					{% for actor in article.casting %}
					<li>
						<img src="{{ actor.image }}" alt="{{ fmt(k.cast_alt, actor.nom) }}" width="250" height="350" loading="lazy">
						<span>{{ actor.nom }}</span>
					</li>
					{% endfor %}
				</ul>
				{% endif %}

				{% if article.video %}
				<h3>{{ k.trailer }}</h3>
				<div class="video">
					<iframe src="{{ article.video }}" title="{{ article.video_titre }}" loading="lazy"
						allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
				</div>
				<a class="link-out" href="{{ article.youtube_link }}" target="_blank" rel="noopener noreferrer">{{ k.watch_on_youtube }} ↗</a>
				{% endif %}
			</div>
		</article>
		{% endfor %}
	</div>
</div>
{% endblock %}
