{# Gabarit commun à toutes les pages : en-tête, navigation, pied de page. #}
{% set meta = t.meta[page] %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{% block title %}{{ meta.title }} | {{ t.site.name }}{% endblock %}</title>
	<meta name="description" content="{{ meta.description }}">
	<meta name="theme-color" content="#0e0b16">
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="{{ t.site.name }}">
	<meta property="og:title" content="{{ meta.title }} | {{ t.site.name }}">
	<meta property="og:description" content="{{ meta.description }}">
	<meta property="og:locale" content="{{ lang == 'en' ? 'en_GB' : 'fr_FR' }}">
	<link rel="icon" type="image/svg+xml" href="images/favicon.svg">
	<link rel="stylesheet" href="{{ asset('css/style.css') }}">
	<script>document.documentElement.classList.add('js');</script>
	<script src="{{ asset('js/main.js') }}" defer></script>
</head>

<body>
	<a class="skip-link" href="#contenu">{{ t.site.skip }}</a>

	<header class="site-header">
		<div class="container header-inner">
			<a class="brand" href="{{ home_url }}">
				<span class="brand__mark" aria-hidden="true">AD</span>
				<span>{{ t.site.name }}</span>
			</a>

			<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
				<span class="sr-only">{{ t.site.menu }}</span>
				<span class="nav-toggle__bars" aria-hidden="true"></span>
			</button>

			<nav id="site-nav" class="site-nav" aria-label="{{ t.site.main_nav }}">
				<ul>
					{% for item in nav %}
					<li><a href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
					{% endfor %}
				</ul>
				<a class="lang-switch" href="{{ switch_url }}" hreflang="{{ switch_lang }}" lang="{{ switch_lang }}" title="{{ t.site.lang_switch_title }}">
					<img src="images/{{ switch_lang == 'en' ? 'drapeau_anglais.jpg' : 'drapeau_francais.jpg' }}" alt="" width="22" height="22">
					<span>{{ t.site.lang_label }}</span>
				</a>
			</nav>
		</div>
	</header>

	<main id="contenu" tabindex="-1">
		{% block main %}{% endblock %}
	</main>

	<footer class="site-footer">
		<div class="container">
			<div class="footer-grid">
				<div>
					<a class="brand" href="{{ home_url }}">
						<span class="brand__mark" aria-hidden="true">AD</span>
						<span>{{ t.site.name }}</span>
					</a>
					<p>{{ t.site.footer_text }}</p>
				</div>
				<nav class="footer-nav" aria-label="{{ t.site.footer_nav }}">
					<ul>
						{% for item in nav %}
						<li><a href="{{ item.url }}">{{ item.label }}</a></li>
						{% endfor %}
						<li><a href="{{ page_urls.a_propos }}#mentions-legales">{{ t.site.legal }}</a></li>
					</ul>
				</nav>
			</div>
			<div class="footer-bottom">
				<p>{{ fmt(t.site.copyright, year) }}</p>
				<a href="#contenu">{{ t.site.back_to_top }}</a>
			</div>
		</div>
	</footer>
</body>
</html>
