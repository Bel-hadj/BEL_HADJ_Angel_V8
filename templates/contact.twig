{% extends "base.twig" %}

{% block main %}

    <section>
        <h2>Contact</h2>
        <form method="post" action="reception.php" novalidate>
            <fieldset>
                <legend><b>A remplir :</b></legend>
                <div class="form-field">
                    <label for="nom">Nom et prénom :</label>
                    <input type="text" id="nom" name="nom" autocomplete="name" required />
                </div>
                <div class="form-field">
                    <label for="email">Adresse mail :</label>
                    <input type="email" id="email" name="email" autocomplete="email" required />
                </div>
                <div class="form-field">
                    <label for="message">Votre message :</label>
                    <textarea class="messg" id="message" name="message" rows="5" required></textarea>
                </div>
                <div class="valid">
                    <button type="submit" name="valider">Envoyer</button>
                </div>
            </fieldset>
        </form>
    </section>

    <section id="carousel">
        <h1 class="h1">K-Dramas ou Mangas : quelle est votre source d'inspiration ?</h1>
        <div class="carousel">
            <div class="slide">
                <img src="images/kdrama5.png" alt="Kdrama 1">
            </div>
            <div class="slide">
                <img src="images/mangas32.jpg" alt="Manga 1">
            </div>
            <div class="slide">
                <img src="images/kdrama13.webp" alt="Kdrama 2">
            </div>
            <div class="slide">
                <img src="images/mangas56.jpg" alt="Manga 2">
            </div>
            <div class="slide">
                <img src="images/kdrama18.jpg" alt="kdrama 3">
            </div>
            <div class="slide">
                <img src="images/kdrama26.jpg" alt="kdrama 4">
            </div>
            <div class="slide">
                <img src="images/mangas60.jpg" alt="Manga 3">
            </div>
            <div class="slide">
                <img src="images/mangas61.jpg" alt="Manga 4">
            </div>
        </div>
    </section>
    
{% endblock main %}
