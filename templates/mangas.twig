{% extends "base.twig" %}

{% block main %}
{% set m = t.mangas %}
{% include "_page_hero.twig" with {eyebrow: m.eyebrow, title: m.title, lead: m.lead} only %}

<div class="container catalog">
	<aside class="catalog__side">
		{% include "_toc.twig" with {title: m.plan, items: articles, prefix: 'manga'} only %}
	</aside>

	<div class="entries">
		{% for article in articles %}
		<article id="manga-{{ article.id }}" class="entry" aria-labelledby="manga-{{ article.id }}-title">
			<div class="entry__media">
				<img src="{{ article.image }}" alt="{{ fmt(m.cover_alt, article.titre) }}" width="250" height="375" loading="lazy">
			</div>

			<div class="entry__body">
				<header class="entry__head">
					<h2 id="manga-{{ article.id }}-title">{{ article.titre }}</h2>
					{% if article.sous_titre %}<p class="entry__subtitle">{{ article.sous_titre }}</p>{% endif %}
					<ul class="chips">
						{% for genre in article.genre|split(' - ') %}
						<li class="chip chip--accent">{{ genre }}</li>
						{% endfor %}
					</ul>
				</header>

				<h3>{{ m.summary }}</h3>
				{% for paragraph in article.texte %}
				<p>{{ paragraph }}</p>
				{% endfor %}

				<h3>{{ m.about }}</h3>
				<p>{{ article.description }}</p>
				<dl class="facts">
					<div><dt>{{ m.labels.auteurs }}</dt><dd>{{ article.auteurs|join(', ') }}</dd></div>
					<div><dt>{{ m.labels.date }}</dt><dd>{{ article.date }}</dd></div>
					<div><dt>{{ m.labels.nombre_de_tomes }}</dt><dd>{{ article.nombre_de_tomes }}</dd></div>
					<div><dt>{{ m.labels.nombre_de_pages }}</dt><dd>{{ article.nombre_de_pages }}</dd></div>
					<div><dt>{{ m.labels.note }}</dt><dd>{{ article.note }}</dd></div>
					<div><dt>{{ m.labels.prix }}</dt><dd>{{ article.prix }}</dd></div>
					{% if article.theme is defined %}
					<div><dt>{{ m.labels.theme }}</dt><dd>{{ article.theme }}</dd></div>
					{% endif %}
				</dl>
			</div>
		</article>
		{% endfor %}
	</div>
</div>
{% endblock %}
