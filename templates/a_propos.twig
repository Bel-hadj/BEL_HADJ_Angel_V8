{% extends "base.twig" %}

{% block main %}
{% set a = t.about %}
{% include "_page_hero.twig" with {eyebrow: a.eyebrow, title: a.title, lead: a.lead} only %}

<section class="container section" aria-labelledby="concept-title">
	<h2 id="concept-title">{{ a.concept_title }}</h2>
	<div class="about-split">
		{% for paragraph in a.concept %}
		<p>{{ paragraph }}</p>
		{% endfor %}
	</div>
</section>

<section class="container section" aria-labelledby="discover-title">
	<div class="section__head">
		<h2 id="discover-title">{{ a.discover_title }}</h2>
	</div>
	<div class="grid-3">
		{% for item in a.discover %}
		<a class="card card--link" href="{{ page_urls[item.link] }}">
			<h3>{{ item.title }}</h3>
			<p>{{ item.text }}</p>
			<span class="tile__cta" aria-hidden="true">→</span>
		</a>
		{% endfor %}
	</div>
</section>

<section class="container section" aria-labelledby="passion-title">
	<div class="section__head">
		<h2 id="passion-title">{{ a.passion_title }}</h2>
	</div>
	<div class="grid-3">
		{% for item in a.passion %}
		<div class="card">
			<h3>{{ item.title }}</h3>
			<p>{{ item.text }}</p>
		</div>
		{% endfor %}
	</div>
</section>

<section class="container section" aria-labelledby="context-title">
	<h2 id="context-title">{{ a.context_title }}</h2>
	<div class="about-split">
		<div>
			{% for paragraph in a.context %}
			<p>{{ paragraph }}</p>
			{% endfor %}
		</div>
		<div>
			<h3>{{ a.tech_title }}</h3>
			<ul class="chips">
				{% for tech in a.tech %}
				<li class="chip chip--gold">{{ tech }}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
</section>

<section class="container section legal" id="mentions-legales" aria-labelledby="legal-title">
	<h2 id="legal-title">{{ a.legal_title }}</h2>
	{% for item in a.legal %}
	<details>
		<summary>{{ item.title }}</summary>
		<p>{{ item.text }}{% if loop.last %} <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>{% endif %}</p>
	</details>
	{% endfor %}
</section>
{% endblock %}
